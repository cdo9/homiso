APP_NAME=Homiso
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://homiso.local

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Valeurs par défaut de Laravel Sail (service "mysql" du docker-compose)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=homiso
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=database

# Google Maps (clé à restreindre au domaine dans Google Cloud Console)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_DEFAULT_LAT=48.8566
GOOGLE_MAP_DEFAULT_LNG=2.3522

# Spot-Hit (envoi SMS) - pas encore lu par le code, voir docs/audit-reprise.md §3
SPOTHIT_API_KEY=
SPOTHIT_FROM=

TELESCOPE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
